set -u
fail=0

while IFS= read -r -d '' f; do
  jq empty "$f" >/dev/null 2>&1 || { echo "invalid JSON: $f"; fail=1; }
done < <(find . -name '*.json' -not -path './.git/*' -print0)

while IFS= read -r -d '' f; do
  out=$(bash -n "$f" 2>&1) || { echo "bash syntax error: $f"; echo "$out"; fail=1; }
done < <(find . -name '*.sh' -not -path './.git/*' -print0)

exit $fail
